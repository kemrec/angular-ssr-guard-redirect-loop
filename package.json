{
  "name": "angular-ssr-guard-redirect-loop",
  "version": "1.0.0",
  "private": true,
  "description": "Minimal reproduction: a cyclic route-guard redirect wedges Angular SSR (@angular/* 22.2.0)",
  "type": "commonjs",
  "scripts": {
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --outfile=dist/server.cjs --tsconfig=tsconfig.json && esbuild src/express-server.ts --bundle --platform=node --format=cjs --external:express --tsconfig=tsconfig.json --outfile=dist/express.cjs"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/platform-server": "22.2.0",
    "@angular/router": "22.2.0",
    "express": "^5.2.1",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
